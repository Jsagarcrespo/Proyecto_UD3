<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="org.example.VentanaGestiones">
  <grid id="rootGestion" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="13" column-count="4">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="820" height="560"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="comp1" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="GESTION DE SUMINISTROS"/>
        </properties>
      </component>
      <component id="comp2" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="ID (automatico)"/>
        </properties>
      </component>
      <component id="comp3" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="2" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Fecha (AAAA-MM-DD)"/>
        </properties>
      </component>
      <component id="comp4" class="javax.swing.JTextField" binding="IdGestion">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="comp5" class="javax.swing.JTextField" binding="Fecha">
        <constraints>
          <grid row="2" column="2" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="comp6" class="javax.swing.JLabel">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Proveedor"/>
        </properties>
      </component>
      <component id="comp7" class="javax.swing.JLabel">
        <constraints>
          <grid row="3" column="2" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Pieza"/>
        </properties>
      </component>
      <component id="comp8" class="javax.swing.JComboBox" binding="ComboProveedores">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="comp9" class="javax.swing.JComboBox" binding="ComboPiezas">
        <constraints>
          <grid row="4" column="2" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="comp10" class="javax.swing.JLabel">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Proyecto"/>
        </properties>
      </component>
      <component id="comp11" class="javax.swing.JLabel">
        <constraints>
          <grid row="5" column="2" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Cantidad"/>
        </properties>
      </component>
      <component id="comp12" class="javax.swing.JComboBox" binding="ComboProyectos">
        <constraints>
          <grid row="6" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="comp13" class="javax.swing.JTextField" binding="Cantidad">
        <constraints>
          <grid row="6" column="2" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="comp14" class="javax.swing.JButton" binding="anadirButton">
        <constraints>
          <grid row="7" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Añadir"/>
        </properties>
      </component>
      <component id="comp15" class="javax.swing.JButton" binding="modificarButton">
        <constraints>
          <grid row="7" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Modificar"/>
        </properties>
      </component>
      <component id="comp16" class="javax.swing.JButton" binding="eliminarButton">
        <constraints>
          <grid row="7" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Eliminar"/>
        </properties>
      </component>
      <component id="comp17" class="javax.swing.JButton" binding="limpiarButton">
        <constraints>
          <grid row="7" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Limpiar"/>
        </properties>
      </component>
      <component id="comp18" class="javax.swing.JLabel">
        <constraints>
          <grid row="8" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Buscar suministros por ID o codigo"/>
        </properties>
      </component>
      <component id="comp19" class="javax.swing.JComboBox" binding="TipoBusqueda">
        <constraints>
          <grid row="9" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="comp20" class="javax.swing.JTextField" binding="Buscar">
        <constraints>
          <grid row="9" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="comp21" class="javax.swing.JButton" binding="buscarButton">
        <constraints>
          <grid row="9" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Buscar"/>
        </properties>
      </component>
      <component id="comp22" class="javax.swing.JLabel">
        <constraints>
          <grid row="10" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Listado de suministros (pulsa una linea para seleccionarlo)"/>
        </properties>
      </component>
      <scrollpane id="listaScrollGestion">
        <constraints>
          <grid row="11" column="0" row-span="1" col-span="4" vsize-policy="7" hsize-policy="7" anchor="8" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="listaTextoGestion" class="javax.swing.JTextArea" binding="Lista">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <component id="comp23" class="javax.swing.JButton" binding="mostrarTodosButton">
        <constraints>
          <grid row="12" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Mostrar todos"/>
        </properties>
      </component>
      <component id="comp24" class="javax.swing.JButton" binding="cerrarButton">
        <constraints>
          <grid row="12" column="2" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Cerrar"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
