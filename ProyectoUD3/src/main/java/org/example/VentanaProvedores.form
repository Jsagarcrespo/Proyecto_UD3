<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="org.example.VentanaProvedores">
  <grid id="principal" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="11" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="12" left="12" bottom="12" right="12"/>
    <constraints>
      <xy x="20" y="20" width="760" height="500"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="item1" class="javax.swing.JLabel">
